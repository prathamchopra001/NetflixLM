# Every NIP_* variable with its default (docs/project-structure.md › Configuration).
# Comments sit on their own lines: some .env readers keep inline "# ..." as part of the value.

# --- Runtime
# auto = probe hardware; cpu = stub model backends (tests/CI)
NIP_PROFILE=auto
# quality | throughput
NIP_PLAN_OBJECTIVE=quality
# Optional: pin a slot to a catalog variant id (NIP_PIN_<SLOT>)
NIP_PIN_TEXT_LLM=
NIP_PIN_VLM=
# Upper bound per GPU; the planner also subtracts memory already in use
NIP_GPU_MEM_UTILIZATION=0.90
# auto locally; set by Helm on Kubernetes
NIP_RAY_ADDRESS=auto
# 0 = no autoscaling
NIP_AUTOSCALE_MAX_GPU_NODES=0

# --- Storage
NIP_DATABASE_URL=postgresql://nip:change_me@postgres:5432/nip
# SeaweedFS locally; empty = native cloud endpoint
NIP_S3_ENDPOINT=http://objectstore:8333
NIP_S3_MEDIA_BUCKET=nip-media
NIP_S3_ARTIFACT_BUCKET=nip-artifacts
# Local weights cache (mount a large disk here)
NIP_MODEL_CACHE=/models
# hf = download (dev); s3://nip-models = internal mirror (egress-free production)
NIP_MODEL_SOURCE=hf
# S3 credentials (SeaweedFS locally; IAM or HMAC keys in the cloud)
AWS_ACCESS_KEY_ID=nip
AWS_SECRET_ACCESS_KEY=change_me

# --- Experiment tracking
NIP_MLFLOW_TRACKING_URI=http://mlflow:5000
NIP_MLFLOW_BACKEND_URI=postgresql://nip:change_me@postgres:5432/mlflow
# benchmark = trace LLM calls only in benchmark runs; off = never
NIP_MLFLOW_TRACE=benchmark
# No usage telemetry to MLflow's servers
MLFLOW_DISABLE_TELEMETRY=true

# --- Egress
# Presidio's email check uses the bundled domain list, never downloads
TLDEXTRACT_PUBLIC_SUFFIX_LIST_URLS=
# Set to 1 in production: weights only from the local cache or internal mirror
HF_HUB_OFFLINE=0

# --- Labelling (docker compose --profile labeling up)
# Label Studio's own variable name for its database password
POSTGRE_PASSWORD=change_me

# --- Public URL (what browsers use; the API base is ${NIP_PUBLIC_URL}/api/v1)
NIP_PUBLIC_URL=http://localhost:8080

# --- Auth
# Must equal the token's `iss` (the URL browsers use)
NIP_OIDC_ISSUER=http://localhost:8180/realms/nip
# Internal fetch URL
NIP_OIDC_JWKS_URL=http://keycloak:8080/realms/nip/protocol/openid-connect/certs
NIP_OIDC_AUDIENCE=nip-api
NIP_OIDC_ROLES_CLAIM=roles

# --- Review thresholds
NIP_TIER_MUST_REVIEW=0.90
NIP_TIER_REVIEW_RECOMMENDED=0.70
NIP_FACT_REVIEW_THRESHOLD=0.80
NIP_INFERRED_STORY_CONFIDENCE_FACTOR=0.85

# --- Cost controls
# auto = derived from the Plan's throughput
NIP_VLM_CALLS_PER_EPISODE_MAX=auto
