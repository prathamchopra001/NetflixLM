{"title": "sintel", "scene": 0, "element": 0, "text": "This blade has a dark past.", "start_ms": 107250, "start_frame": 2574, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 1, "text": "It has shed much innocent blood.", "start_ms": 111800, "start_frame": 2683, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 2, "text": "You're a fool for traveling alone, so completely unprepared.", "start_ms": 118000, "start_frame": 2832, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 3, "text": "You're lucky your blood's still flowing.", "start_ms": 121750, "start_frame": 2922, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 4, "text": "Thank you.", "start_ms": 125250, "start_frame": 3006, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 5, "text": "So...", "start_ms": 127500, "start_frame": 3060, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 6, "text": "What brings you to the land of the gatekeepers?", "start_ms": 129400, "start_frame": 3106, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 7, "text": "I'm searching for someone.", "start_ms": 135000, "start_frame": 3240, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 8, "text": "Someone very dear? A kindred spirit?", "start_ms": 138000, "start_frame": 3312, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 9, "text": "A dragon.", "start_ms": 143400, "start_frame": 3442, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 10, "text": "A dangerous quest for a lone hunter.", "start_ms": 148850, "start_frame": 3572, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 0, "element": 11, "text": "I've been alone for as long as I can remember.", "start_ms": 152950, "start_frame": 3671, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 1, "element": 0, "text": "We're almost done. Shhh...", "start_ms": 207250, "start_frame": 4974, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 1, "element": 1, "text": "Hey, sit still.", "start_ms": 210750, "start_frame": 5058, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 2, "element": 0, "text": "Good night, Scales.", "start_ms": 228250, "start_frame": 5478, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 3, "element": 0, "text": "Get him, Scales! Come on!", "start_ms": 250350, "start_frame": 6008, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 4, "element": 0, "text": "Scales?", "start_ms": 265250, "start_frame": 6366, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 5, "element": 0, "text": "Yeah! Come on!", "start_ms": 304000, "start_frame": 7296, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 6, "element": 0, "text": "Scales!", "start_ms": 338750, "start_frame": 8130, "labeller": "agent", "basis": "srt-cue-start"}
{"title": "sintel", "scene": 7, "element": 0, "text": "I have failed.", "start_ms": 445850, "start_frame": 10700, "labeller": "agent", "basis": "srt-cue-start"}
