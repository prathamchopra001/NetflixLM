<!-- Label Studio config for shot cuts. {framerate} is filled in by push: 24 for Sintel,
     23.976023976 for NTSC media (never the string 24000/1001: Label Studio reads it as 24). -->
<View>
  <Header value="Mark the FIRST frame of every new shot. Ignore the first frame of the clip."/>
  <Video name="video" value="$video" framerate="{framerate}" timelineHeight="80"/>
  <TimelineLabels name="cuts" toName="video">
    <Label value="Cut" background="#d62728"/>
  </TimelineLabels>
</View>
